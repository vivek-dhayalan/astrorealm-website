# Copy to .env and fill in. Never commit .env.
MATCHAPI_ENV=production
SITE_NAME=AstroRealm
SITE_BASE_URL=https://astrorealm.in
SOURCE_URL=https://github.com/vivek-dhayalan/astrorealm-website
CONTACT_EMAIL=

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile → Add site)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 measurement id (G-XXXXXXXXXX)
GA_MEASUREMENT_ID=

# Google AdSense (after the site is approved)
ADSENSE_CLIENT=
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_SIDE=
ADSENSE_SLOT_BOTTOM=

# Share image shown when links are posted on WhatsApp/social media (1200x630, absolute URL); empty = none
OG_IMAGE_URL=

# Map for "Pick on map": OpenFreeMap (free, no key, commercial use allowed). Change only to switch provider.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

RATE_LIMIT_PER_MINUTE=20
# Header carrying the visitor IP (first entry used) — x-forwarded-for on Google Cloud Run
CLIENT_IP_HEADER=x-forwarded-for
MATCHAPI_NOMINATIM=0

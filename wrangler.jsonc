// Cloudflare deployment for AstroRealm: a small Worker in front of the Python app running as a container.
// Requires the Workers Paid plan. Deploy with:  npx wrangler deploy   (Docker must be running)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astrorealm",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "containers": [
    {
      "class_name": "AstroRealmApp",
      "image": "./Dockerfile",
      "instance_type": "basic",   // 1/4 vCPU, 1 GiB memory, 4 GB disk
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "AstroRealmApp", "name": "APP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AstroRealmApp"] }],

  // Public settings (not secret). Secrets go in with:  npx wrangler secret put TURNSTILE_SECRET_KEY
  "vars": {
    "MATCHAPI_ENV": "production",
    "SITE_NAME": "AstroRealm",
    "SITE_BASE_URL": "https://astrorealm.in",
    "SOURCE_URL": "https://github.com/vivek-dhayalan/astrorealm-website",
    "CONTACT_EMAIL": "",
    "TURNSTILE_SITE_KEY": "",
    "GA_MEASUREMENT_ID": "",
    "ADSENSE_CLIENT": "",
    "ADSENSE_SLOT_TOP": "",
    "ADSENSE_SLOT_SIDE": "",
    "ADSENSE_SLOT_BOTTOM": "",
    "MAP_STYLE_URL": "https://tiles.openfreemap.org/styles/liberty",
    "RATE_LIMIT_PER_MINUTE": "20"
  }

  // When the domain is on Cloudflare, uncomment to serve the site on it:
  // , "routes": [
  //     { "pattern": "astrorealm.in", "custom_domain": true },
  //     { "pattern": "www.astrorealm.in", "custom_domain": true }
  //   ]
}
